# Development only. Replace credentials before deploying, keep .env private.
SITEPROOF_MODE=fixture
SITEPROOF_TENANT_KEY=local-development-key
# Optional JSON mapping replaces the default tenant credential; migrate seeds each tenant.
# SITEPROOF_TENANT_KEYS_JSON='{"tenant-a":"replace-with-unique-key","tenant-b":"another-unique-key"}'
SITEPROOF_BROWSER_KEY=local-browser-key
SITEPROOF_RENDER_KEY=local-render-key
SITEPROOF_DATABASE_URL=postgresql://siteproof:siteproof@postgres:5432/siteproof
SITEPROOF_REDIS_URL=redis://redis:6379/0
SITEPROOF_BROWSER_URL=http://browser:8081
SITEPROOF_WEB_URL=http://web:3000
SITEPROOF_S3_ENDPOINT=http://minio:9000
SITEPROOF_S3_ACCESS_KEY=minioadmin
SITEPROOF_S3_SECRET_KEY=minioadmin
SITEPROOF_S3_BUCKET=siteproof
# Live mode requires chat and embedding credentials. Unknown prices retain unknown cost.
SITEPROOF_MODEL_KEY=
SITEPROOF_MODEL_URL=https://api.openai.com/v1
SITEPROOF_MODEL_ID=gpt-4.1-mini
SITEPROOF_EMBEDDING_MODEL=text-embedding-3-small
SITEPROOF_EMBEDDING_VERSION=v1
# Empty URL uses MODEL_URL. Keys are NOT implicitly shared.
SITEPROOF_EMBEDDING_URL=
SITEPROOF_EMBEDDING_KEY=
# Set true only if this provider/account explicitly supports both endpoints.
SITEPROOF_EMBEDDING_USE_MODEL_CREDENTIALS=false
# Optional fail-closed monetary policy; otherwise strict token/call/time limits apply when unpriced.
SITEPROOF_REQUIRE_KNOWN_PRICES=false
# Single-host initial live validation: three API audits, one benchmark; do not reset to bypass the cap.
SITEPROOF_LIVE_VALIDATION_SESSION=live-validation-v1
# Operator-supplied current exchange rate, needed by the EUR5 validation ledger for priced runs.
SITEPROOF_USD_PER_EUR=
# CLI validation API credential (never passed to the frontend).
SITEPROOF_VALIDATION_TENANT_KEY=
# Set current USD prices per million tokens for the selected models; blank means unknown.
SITEPROOF_INPUT_COST_PER_MILLION=
SITEPROOF_OUTPUT_COST_PER_MILLION=
SITEPROOF_EMBEDDING_COST_PER_MILLION=
SITEPROOF_MODEL_OUTPUT_LIMIT=3000
SITEPROOF_VISION_TOKEN_ALLOWANCE=2048
# Optional external/self-hosted Hugging Face TEI reranker; not started by Compose.
SITEPROOF_RERANK_URL=
SITEPROOF_RERANK_MODEL=
SITEPROOF_RERANK_KEY=

# Test-only fixed HTTP host routed to isolated fixture service; leave false outside integration.
SITEPROOF_TEST_FIXTURE_HTTP=false
# Controlled live-model testing ONLY, exact isolated fixture host:80/overflow.
SITEPROOF_LIVE_VALIDATION_FIXTURE=false

# Optional fixed public origin when deployed behind a TLS reverse proxy.
# SITEPROOF_PUBLIC_ORIGIN=https://your-private-siteproof.example
