FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers HOME=/tmp
WORKDIR /app
COPY pyproject.toml requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock && playwright install --with-deps chromium && chmod -R a+rX /opt/browsers

WORKDIR /opt/audit
COPY infra/package.json infra/package-lock.json ./
RUN npm ci
WORKDIR /app
COPY services ./services
COPY evals ./evals
ENV PYTHONPATH=/app/services
USER 65534:65534
CMD ["uvicorn","siteproof.browser:app","--host","0.0.0.0","--port","8081","--workers","1"]
